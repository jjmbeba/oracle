{
  "name": "@oracle/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint src",
    "test": "vitest run src",
    "format": "oxfmt -c ../../.oxfmt.json src drizzle.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "tsx src/check.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@oracle/domain": "workspace:*",
    "drizzle-orm": "^0.45.0",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.8",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
