{
  "name": "@oracle/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build --noEmit && vite build",
    "type-check": "vue-tsc --build --noEmit",
    "lint": "oxlint src vite.config.ts",
    "test": "vitest run src",
    "format": "oxfmt -c ../../.oxfmt.json src vite.config.ts index.html"
  },
  "dependencies": {
    "@oracle/domain": "workspace:*",
    "@tanstack/vue-query": "^5.101.0",
    "better-auth": "^1.6.15",
    "maplibre-gl": "^5.24.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.1.0",
    "sass": "^1.101.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.0.0",
    "vue-tsc": "^3.1.0"
  }
}
