{
  "name": "@oracle/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint src",
    "test": "vitest run src",
    "format": "oxfmt -c ../../.oxfmt.json src"
  },
  "dependencies": {
    "@oracle/domain": "workspace:*",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
